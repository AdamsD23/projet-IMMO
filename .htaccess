# Accueil Immo — règles Apache (hébergement PHP classique ou Docker)
Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Transmet l'en-tête Authorization (jeton de connexion) à PHP
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Fichiers privés : jamais servis
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(tests|archive|node_modules|docker)(/|$) - [F,L]
RewriteRule \.(sql|md|json|lock|ini|log|sh|yaml)$ - [F,L]
RewriteRule ^router\.php$ - [F,L]

# Toutes les URL /api/... passent par le point d'entrée de l'API
RewriteRule ^api(/.*)?$ api/index.php [END,QSA]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
